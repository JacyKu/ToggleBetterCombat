{
  "schemaVersion": 1,
  "id": "togglebettercombat",
  "version": "${version}",
  "name": "Toggle Better Combat",
  "description": "Adds a keybind to toggle Better Combat's weapon swinging per player.",
  "authors": [
    "jkitter",
    "Deepacat"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.togglebettercombat.fabric.ToggleBetterCombatFabric"
    ],
    "client": [
      "dev.togglebettercombat.fabric.client.ToggleBetterCombatFabricClient"
    ]
  },
  "mixins": [
    "togglebettercombat.mixins.json",
    "togglebettercombat.client.mixins.json"
  ],
  "depends": {
    "minecraft": ">=1.20.1 <1.20.2",
    "fabricloader": ">=0.14.21",
    "fabric-api": ">=0.83.1",
    "architectury": ">=9.2.0 <10.0.0",
    "bettercombat": ">=1.9.0 <1.10.0"
  }
}
